# ---------- Sending account ----------
EMAIL_USER=your-address@gmail.com
EMAIL_FROM_NAME=Harsh Dubey
# Optional: where replies should go, if different from EMAIL_USER
EMAIL_REPLY_TO=

# ---------- Mail transport ----------
#   smtp      (default) Gmail SMTP (465) + App Password, IMAP (993) for bounces.
#             Works locally. Render BLOCKS both ports -> use gmail_api there.
#   gmail_api Gmail API over HTTPS/443 for sending AND bounce reading. Works on Render.
MAIL_TRANSPORT=smtp

# --- smtp transport ---
# 16-char Google "App Password" (not your password). Needs 2FA.
# https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
# Bounce reader defaults to EMAIL_USER / EMAIL_PASSWORD; set only if it differs.
IMAP_USER=
IMAP_PASSWORD=

# --- gmail_api transport ---
# Desktop OAuth client from Google Cloud Console; then run: npm run google-token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---------- Google Sheet (Apps Script web app) ----------
# The deployed web-app URL, ending in /exec
GOOGLE_SHEET_API=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
# Optional: only set this if your Apps Script validates a ?token= / body token.
GOOGLE_SHEET_API_TOKEN=

# ---------- Campaign behaviour ----------
PORT=3000
# Shared secret; cron-job.org sends it as header "x-campaign-secret" or "?key=".
CAMPAIGN_SECRET=change-me-to-a-long-random-string
# Max emails per invocation. With an hourly cron: BATCH_SIZE x 24 must stay
# under Gmail's ~500/day cap (Workspace: ~2000). 15/hr = 360/day.
BATCH_SIZE=15
# Pause between sends, milliseconds.
SEND_DELAY_MS=1500
# Also re-send rows currently marked "Failed".
RETRY_FAILED=false

# ---------- Bounce handling ----------
# Before each run, read delivery-failure notices and set matching rows to "Bounced".
PROCESS_BOUNCES=true
BOUNCE_LOOKBACK_DAYS=3

# Log actions but do not actually send or write status.
DRY_RUN=false

# ---------- Email content ----------
# Placeholders: {{name}} (first name), {{fullname}}, {{company}}, {{title}}
EMAIL_SUBJECT=AI Engineer & full-stack developer exploring roles at {{company}}
