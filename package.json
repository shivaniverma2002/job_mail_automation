{
  "name": "job-mail-automation",
  "version": "1.0.0",
  "description": "Automated job-outreach emailer: reads contacts from a Google Sheet, sends via Gmail SMTP, writes status back to the sheet.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "send": "node scripts/runOnce.js",
    "bounces": "node scripts/processBounces.js",
    "google-token": "node scripts/getGoogleToken.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^6.9.16"
  }
}
